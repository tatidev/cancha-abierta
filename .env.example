# Configuración de Base de Datos Turso (libSQL)
# Si no defines estas variables, la aplicación funcionará automáticamente
# con una base de datos local SQLite (file:padel.db) sin necesidad de configurar nada.

# Para producción con Turso Cloud (gratis):
# 1. Crea tu base de datos en https://turso.tech o con CLI: `turso db create padel-torneo`
# 2. Obtén la URL: `turso db show padel-torneo --url`
# 3. Obtén el Token: `turso db tokens create padel-torneo`

TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui
